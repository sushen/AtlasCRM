# Documentation only: the launcher reads existing environment variables.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
# Meta app secret is required to authenticate POST webhooks.
WHATSAPP_APP_SECRET=
# Use the supported Graph version selected for your Meta app, e.g. v25.0.
WHATSAPP_GRAPH_API_VERSION=
# Comma-separated Firebase Auth UIDs allowed to send from the web UI.
# An empty list disables web sending; obtain UIDs from your private Firebase console.
WHATSAPP_ALLOWED_USER_UIDS=
ATLAS_FIREBASE_PROJECT_ID=atlascrm-c5722
# Optional path to a private server credential file OUTSIDE the repository.
GOOGLE_APPLICATION_CREDENTIALS=
HOST=127.0.0.1
PORT=3000
# Local read-only catalog preview; never put this buyer key in browser code.
CANBOSO_BUYER_API_KEY=
CATALOG_PREVIEW_PORT=3100
# Telegram channel destination; legacy variable name also accepts group/invite links.
TELEGRAM_GROUP_URL=
# Dedicated BotFather token, server-only. Never paste into browser code.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric group/DM IDs allowed to use the bot.
TELEGRAM_CATALOG_CHAT_IDS=
# Explicit opt-in for catalog replies to anyone starting a private bot chat.
TELEGRAM_PUBLIC_CATALOG_DMS=false
ATLAS_WORKER_URL=https://atlas.meshstocks.workers.dev
ATLAS_ADMIN_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Canonical Cloudflare spelling; existing CANBOSO_* remains supported locally.
CANBOSS_BUYER_API_KEY=
CANBOSS_API_BASE_URL=https://canboso.com
# Worker dashboard variables (local .env is never uploaded automatically).
FIREBASE_PROJECT_ID=atlascrm-c5722
CATALOG_ALLOWED_ORIGINS=https://atlascrm-c5722.web.app,https://atlascrm-c5722.firebaseapp.com
CATALOG_PUBLIC_ENABLED=true
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_USERNAME=AtlasCrmMarketBot
# Worker-only: reviewed layout and explicit Firebase product IDs to publish.
TELEGRAM_CLEAN_MENU=false
TELEGRAM_OWN_PRODUCT_IDS=
# Private shop admin IDs; channel owner must be selected explicitly.
TELEGRAM_SHOP_ENABLED=false
TELEGRAM_SHOP_ADMIN_IDS=
TELEGRAM_SHOP_SUPPORT_URL=
# Prepared manual payment provider. No production activation is implicit.
MANUAL_CHECKOUT_ENABLED=false
PAYMENT_PROVIDER=binance_pay
PAYMENT_MODE=manual
BINANCE_PAY_UID=
BINANCE_PAY_NAME=
PAYMENT_CURRENCY=USDT
PAYMENT_DECIMALS=6
# Explicit business conversion rule, never inferred from market prices.
PAYMENT_USD_USDT_RATE=
PAYMENT_VERIFICATION_MODE=admin_manual
PAYMENT_DELIVERY_MODE=admin_manual
# Original QR stays outside public images/Hosting. Workers use same-bot file ID.
BINANCE_PAY_QR_PATH=
BINANCE_PAY_QR_SHA256=
BINANCE_PAY_QR_FILE_ID=
BINANCE_PAY_PAYMENT_LINK=
BINANCE_PAY_LINK_VERIFIED=false
# Optional partner tracking: disabled until separately approved/configured.
PARTNER_TRACKING_ENABLED=false
PARTNER_HASH_SECRET=
# Dedicated same-project service account JSON; Cloudflare Secret only in production.
PARTNER_FIRESTORE_SERVICE_ACCOUNT=

# Private owned inventory. Disabled until key backup and operator release approval.
INVENTORY_ENABLED=false
INVENTORY_STORAGE=firestore
# Server secret JSON: {"activeKeyId":"v1","keys":{"v1":"BASE64_32_BYTES"},"fingerprintKey":"BASE64_32_BYTES"}
# Generate privately; never place a real key in this example or frontend config.
INVENTORY_KEYRING=
# Read-only new supplier preparation. Never publish this token or invoke orders automatically.
NAM_RESELLER_TOKEN=
# Must be confirmed with supplier; no guessed currency conversion.
NAM_RESELLER_CURRENCY=USD

# Disabled until the new API/token/response and exact product mappings are verified.
MULTI_SUPPLIER_ENABLED=false
