{
  "hosting": {
    "public": ".firebase/hosting-public",
    "headers": [{ "source": "**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  },
  "firestore": {
    "database": "(default)",
    "location": "asia-south1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
