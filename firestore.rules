rules_version = '2';
service cloud.firestore { match /databases/{database}/documents { function signedIn(){ return request.auth != null; } match /customers/{id} { allow read, create, update, delete: if signedIn(); } match /activities/{id} { allow read, create, update: if signedIn(); allow delete: if false; } match /followups/{id} { allow read, create, update: if signedIn(); allow delete: if false; } match /products/{id} { allow read, write: if signedIn(); } match /purchases/{id} { allow read, write: if signedIn(); } match /subscriptions/{id} { allow read, write: if signedIn(); } match /payments/{id} { allow read, write: if signedIn(); } match /renewals/{id} { allow read, write: if signedIn(); } }
}
